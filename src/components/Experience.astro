---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="content-section">
      <div>
        <div class="section-layout">
          <div class="section-heading">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Experience
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="section-content">
            <div class="relative">
              {siteConfig.experience.map((exp, index) => (
                <div class="relative mb-6 last:mb-0">
                  {/* Experience card */}
                  <div class="experience-card bg-white rounded-lg border border-gray-200 p-4 sm:p-5 md:p-6">
                    <div class="experience-heading flex flex-col sm:flex-row sm:items-start sm:justify-between gap-x-6 mb-4">
                      <div>
                        <h3 class="text-lg sm:text-xl font-semibold text-gray-900">
                          {exp.title}
                        </h3>
                        <p
                          class="text-base sm:text-lg"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {exp.company}
                        </p>
                      </div>
                      <span class="text-xs sm:text-sm text-gray-500 mt-2 sm:mt-0 shrink-0">
                        {exp.dateRange}
                      </span>
                    </div>

                    <div class="experience-details min-w-0">
                    {exp.impactHighlights && exp.impactHighlights.length > 0 && (
                      <div class="mb-6 rounded-lg bg-gray-50 p-4 sm:p-5">
                        <h4 class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-500">
                          Impact Highlights
                        </h4>
                        {exp.impactContext && (
                          <p class="mb-5 text-sm leading-relaxed text-gray-600">{exp.impactContext}</p>
                        )}
                        <dl class="grid grid-cols-3 gap-3 sm:gap-4">
                          {exp.impactHighlights.map((highlight) => (
                            <div class="flex flex-col gap-2">
                              <dt class="order-2 text-xs sm:text-sm leading-relaxed text-gray-600">
                                {highlight.label}
                              </dt>
                              <dd class="text-3xl sm:text-4xl font-bold tracking-tight" style={`color: ${siteConfig.accentColor}`}>
                                {highlight.value}
                              </dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                    )}

                    {exp.bullets.length > 0 && (
                    <ul class="space-y-2">
                      {exp.bullets.map((bullet) => (
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                          <span class="text-sm sm:text-base text-gray-600">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                    )}
                    {exp.achievement && (
                      <div class="mt-6 border-t border-gray-100 pt-4">
                        <h4 class="mb-2 text-sm font-semibold text-gray-900">{exp.achievement.title}</h4>
                        <p class="text-sm leading-relaxed text-gray-700">{exp.achievement.description}</p>
                      </div>
                    )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
