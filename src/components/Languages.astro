---
import { siteConfig } from "../config";
const hasLanguages = siteConfig.languages && siteConfig.languages.length > 0;
---

{hasLanguages && (
  <section id="languages" aria-labelledby="languages-heading" class="content-section">
    <div class="section-layout">
      <div class="section-heading">
        <h2 id="languages-heading" class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          Languages
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${siteConfig.accentColor}`} />
      </div>
      <dl class="section-content grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {siteConfig.languages.map((language) => (
          <div class="bg-gray-50 rounded-xl border border-gray-200 p-4 sm:p-6">
            <dt class="text-lg sm:text-xl font-semibold text-gray-900">
              <span lang={language.code}>{language.nativeName}</span>
              {language.nativeName !== language.name && (
                <span class="block mt-1 text-sm font-normal text-gray-500">{language.name}</span>
              )}
            </dt>
            <dd class="mt-2 text-sm sm:text-base text-gray-600">{language.proficiency}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}
