---
import { siteConfig } from "../config";
const resumeUrl = `${import.meta.env.BASE_URL}/${siteConfig.resume}`;
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="hero relative isolate overflow-hidden border-b border-gray-100 bg-white"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="hero-glow absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="hero-content w-full max-w-6xl mx-auto">
    <p class="mb-5 text-sm font-medium tracking-wide text-gray-500">Hello, I'm</p>
    <h1 id="hero-heading" class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
      {siteConfig.name}<span style="color: var(--accent-color)">.</span>
    </h1>
    <p class="mt-4 max-w-3xl text-lg font-medium leading-relaxed sm:text-xl" style="color: var(--accent-color)">
      {siteConfig.title}
    </p>
    <p class="mt-5 max-w-2xl text-base leading-8 text-gray-600 sm:text-lg">
      {siteConfig.heroDescription}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={resumeUrl} download="Michael-He-Resume.pdf" class="hero-primary inline-flex min-h-12 items-center gap-2 rounded-lg px-5 py-3 text-sm font-semibold text-white">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h5" />
        </svg>
        Resume
      </a>
    </div>
    <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-gray-500">
      <span>{siteConfig.location}</span>
      <span class="hidden h-4 w-px bg-gray-300 sm:block" aria-hidden="true"></span>
      <a href={`mailto:${siteConfig.social.email}`} aria-label="Email" title="Email" class="social-link inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </a>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub" class="social-link inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6 1.1 4.9 1.4 4.9 1.4a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 3.5 7.8c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
        </svg>
      </a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn" class="social-link inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 1 0-4 0" />
          <rect x="3" y="3" width="18" height="18" rx="4" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-glow { background: radial-gradient(ellipse at top left, color-mix(in srgb, var(--accent-color) 9%, white), transparent 70%); }
  .hero-primary { background-color: var(--accent-color); transition: filter 150ms; }
  .hero-primary:hover { filter: brightness(0.88); }
  .social-link:hover { color: var(--accent-color); }
  a:focus-visible { outline: 2px solid var(--accent-color); outline-offset: 5px; }
</style>
